# ─── Supabase (auth + mood/journal storage) ─────────────────────────────
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set this to true after enabling the Google provider in Supabase.
VITE_AUTH_GOOGLE_ENABLED=false

# ─── Chat server (proxies the Mistral API) ───────────────────────────────
# The mobile app never sees the Mistral key. It calls this small server,
# which holds MISTRAL_API_KEY in its own environment. Deploy the
# companion service (see DEPLOY.md) and put its public URL here. Leave
# blank to fall back to the bundled demo server.
VITE_CHAT_SERVER_URL=
