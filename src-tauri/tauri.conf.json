{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mabuhai",
  "version": "0.1.0",
  "identifier": "com.user.mabuh-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mabuhai",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["mabuhai"],
          "appLink": false
        }
      ]
    },
    "http": {
      "dangerousRemoteDomainIpcAccess": [
        {
          "domain": "huggingface.co",
          "windows": ["main"],
          "enableTauriAPI": true
        }
      ]
    }
  }
}
