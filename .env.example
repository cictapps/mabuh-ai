# ─── Supabase (auth + mood/journal storage) ─────────────────────────────
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google auth is shown by default. Set this to false only when the
# Google provider has not been enabled in Supabase yet.
VITE_AUTH_GOOGLE_ENABLED=true

# ─── Chat server (proxies the Mistral API) ───────────────────────────────
# The mobile app authenticates to the chat server with the logged-in
# Supabase session's access token (Authorization: Bearer <jwt>). The
# server must verify the JWT against your Supabase project's JWKS — it
# must NOT compare it against a static CHAT_API_KEYS secret.
#
# The app calls this small server, which holds MISTRAL_API_KEY in its
# own environment. Deploy the companion service (see DEPLOY.md) and put
# its public URL here. Leave blank to fall back to the bundled server.
VITE_CHAT_SERVER_URL=
